---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title={"WINSERV | Page not found"}
  path={"/en/404.html"}
  active={"none"}
  noindex={true}
>
<div class="page-hero page-hero--short">
  <div class="section-label blue">Error 404</div>
  <h1 class="error-title">Page not found</h1>
  <p class="error-text">The address you followed does not exist or has moved.</p>
  <div class="error-actions">
    <a href="/en/" class="btn-primary">Go to the home page</a>
    <a href="/en/contact.html" class="btn-outline">Talk to the team</a>
  </div>
</div>
</BaseLayout>
