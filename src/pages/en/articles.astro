---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title={"WINSERV | Articles"}
  description={"Winserv's articles and educational material on technology, security and good digital practice."}
  path={"/en/articles.html"}
  ogTitle={"Articles — WINSERV"}
  ogDescription={"Winserv's articles and educational material on technology, security and good digital practice."}
  ogType={"website"}
  active={"conteudo"}
>
<div class="page-hero">
  <div class="section-label">Learn more</div>
  <h1>Articles</h1>
  <p>Articles and material on technology, security and good digital practice.</p>
</div>

<section>
  <div class="container">
    <div class="content-category">
      <div class="category-label">Company</div>
      <div class="content-grid">
        <a class="content-card" href="/en/mission.html">
          <img src="/images/missao.webp" alt="Our mission" />
          <div class="content-card-body">
            <h3>Our mission</h3>
            <p>What defines us as a company on the journey of improving lives together with clients and users.</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
        <a class="content-card" href="/en/values.html">
          <img src="/images/valores.webp" alt="Values and Principles" />
          <div class="content-card-body">
            <h3>Values and Principles</h3>
            <p>A list of practices, goals and doctrines that define and guide us every day.</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
        <a class="content-card" href="/en/information-technology.html">
          <img src="/images/ti.webp" alt="What is IT?" />
          <div class="content-card-body">
            <h3>What is "IT"?</h3>
            <p>Ink Technicians? Internet Troubleshooters? Let's clear this idea up once and for all!</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
      </div>
    </div>

    <div class="content-category">
      <div class="category-label">Technology and Society</div>
      <div class="content-grid">
        <a class="content-card" href="/en/green-it.html">
          <img src="/images/tiverde.webp" alt="Green Technology" />
          <div class="content-card-body">
            <h3>Green Technology</h3>
            <p>How the responsible use of sustainable resources can secure a future for everyone.</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
        <a class="content-card" href="/en/screen-time.html">
          <img src="/images/telas.webp" alt="Excessive Screen Time" />
          <div class="content-card-body">
            <h3>Excessive Screen Time</h3>
            <p>Understand why uncontrolled exposure to screens can have unexpected consequences later on.</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
        <a class="content-card" href="/en/pornography-exposure.html">
          <img src="/images/exposicao.webp" alt="Exposure to Pornography" />
          <div class="content-card-body">
            <h3>Exposure to Pornography</h3>
            <p>A reflection on how access to adult content can affect children in tragic ways.</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
        <a class="content-card" href="/en/internet-filter.html">
          <img src="/images/filtro.webp" alt="Filtering the Internet" />
          <div class="content-card-body">
            <h3>Filtering the Internet</h3>
            <p>Practical tips to block inappropriate content and protect your children online.</p>
            <span class="content-card-link">Read &#8594;</span>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
