---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="WINSERV | Erro" path="/error.html" noindex>
<div class="page-hero page-hero--short">
  <div class="section-label blue">Erro</div>
  <h1 class="error-title">Algo deu errado</h1>
  <p class="error-text">Não conseguimos atender este pedido agora. Tente de novo em instantes.</p>
  <div class="error-actions">
    <a href="/" class="btn-primary">Ir para o início</a>
    <a href="/contato.html" class="btn-outline">Falar com a equipe</a>
  </div>
</div>
</BaseLayout>
