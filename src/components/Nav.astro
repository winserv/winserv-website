---
import { LOCALES, LANG, href, twins, external } from '../i18n/routes.mjs';
import { UI } from '../i18n/ui.mjs';
interface Props { active: 'inicio' | 'solucoes' | 'conteudo' | 'none'; locale: string; routeKey: string; noindex: boolean }
const { active, locale, routeKey, noindex } = Astro.props;
const on = (k: string) => (active === k ? 'active' : undefined);
const t = UI[locale].nav;
const WIFI = external('wifiHome', locale);
// The switcher (spec §4): the page's other languages; a noindex page has no twin, so it offers
// the homes. Never .nav-new — the badge gate wants exactly one, on the WiFi tab.
const target = (l: string) => (noindex ? twins('index')[l] : twins(routeKey)[l]);
const others = LOCALES.filter((l) => l !== locale && target(l)).map((l) => ({ l, to: target(l) }));
---
<nav class="topnav">
  <a class="wordmark" href={href('index', locale)}><span class="win">WIN</span><span class="serv">SERV</span></a>
  <ul class="nav-links">
    <li><a href={href('index', locale)} class={on('inicio')}>{t.home}</a></li>
    <li><a href={href('solucoes', locale)} class={on('solucoes')}>{t.solutions}</a></li>
    <li><a href={href('conteudo', locale)} class={on('conteudo')}>{t.articles}</a></li>
    <li><a href={WIFI}>{t.wifi}<span class="nav-new">{t.badge}</span></a></li>
  </ul>
  {others.length > 0 && (
    <div class="nav-lang">
      <span class="nav-lang-current" lang={LANG[locale].html}>{LANG[locale].short}</span>
      {others.map((o) => <a href={o.to} hreflang={LANG[o.l].hreflang} lang={LANG[o.l].html} aria-label={LANG[o.l].name}>{LANG[o.l].short}</a>)}
    </div>
  )}
  <a class="btn-nav" href={href('contato', locale)}>{t.contact}</a>
  <button class="nav-burger" id="burger" aria-label={t.menu}><span></span><span></span><span></span></button>
</nav>
<div class="nav-mobile" id="mobile-menu">
  <a href={href('index', locale)}>{t.home}</a>
  <a href={href('solucoes', locale)}>{t.solutions}</a>
  <a href={href('conteudo', locale)}>{t.articles}</a>
  <a href={WIFI}>{t.wifi}</a>
  <a href={href('contato', locale)}>{t.contact}</a>
  {others.length > 0 && (
    <div class="nav-mobile-lang">
      {others.map((o) => <a href={o.to} hreflang={LANG[o.l].hreflang} lang={LANG[o.l].html}>{LANG[o.l].name}</a>)}
    </div>
  )}
</div>
