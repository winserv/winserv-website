---
import { href } from '../i18n/routes.mjs';
import { UI } from '../i18n/ui.mjs';
interface Props { locale: string }
const { locale } = Astro.props;
const t = UI[locale];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="wordmark" href={href('index', locale)}><span class="win">WIN</span><span class="serv">SERV</span></a>
        <p>{t.footer.tagline}</p>
      </div>
      <div class="footer-col">
        <h4>{t.footer.navigate}</h4>
        <ul>
          <li><a href={href('index', locale)}>{t.nav.home}</a></li>
          <li><a href={href('solucoes', locale)}>{t.nav.solutions}</a></li>
          <li><a href={href('conteudo', locale)}>{t.nav.articles}</a></li>
          <li><a href={href('wifi', locale)}>{t.nav.wifi}</a></li>
          <li><a href={href('contato', locale)}>{t.nav.contact}</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h4>{t.footer.company}</h4>
        <ul>
          <li><a href={href('missao', locale)}>{t.footer.mission}</a></li>
          <li><a href={href('valores', locale)}>{t.footer.values}</a></li>
          <li><a href={href('privacidade', locale)}>{t.footer.privacy}</a></li>
          <li><a href="https://www.linkedin.com/company/winserv/" target="_blank" rel="noopener">LinkedIn</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <!-- The trade name is not translated; marked so the language-leak gates read it as Portuguese on purpose. -->
      <span><span lang="pt-BR">Winserv Tecnologia da Informação</span> &mdash; CNPJ 10.411.266/0001-80 &mdash; Rio Grande, RS</span>
      <span>&copy; 2026 Winserv TI</span>
    </div>
  </div>
</footer>
