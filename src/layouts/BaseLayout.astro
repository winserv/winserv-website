---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import WifiLinks from '../components/WifiLinks.astro';
import { ORIGIN, LANG, routeOf, twins, noindex as tableNoindex, ogImage } from '../i18n/routes.mjs';

interface Props {
  title: string;
  description?: string;
  path: string;                 // the page's path exactly as in src/i18n/routes.mjs
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  active?: 'inicio' | 'solucoes' | 'conteudo' | 'wifi' | 'none';
  scripts?: string[];           // files under public/, loaded with defer
  noindex?: boolean;            // must agree with the table
  googleSiteVerification?: string;
}
const {
  title, description, path, ogTitle = title, ogDescription = description, ogType = 'website',
  active = 'none', scripts = [], noindex = false, googleSiteVerification,
} = Astro.props;

// Spec sub-project 3 §4: a page the table does not know cannot be built.
const route = routeOf(path);
if (!route) throw new Error(`BaseLayout: path ${path} is not in src/i18n/routes.mjs`);
const { key, locale } = route;
if (noindex !== tableNoindex(key)) throw new Error(`BaseLayout: ${path} says noindex=${noindex}, the table says ${tableNoindex(key)}`);
const lang = LANG[locale];
const url = ORIGIN + path;                     // the table's own value — never Astro.url
const image = ORIGIN + ogImage(locale, key);
const tw = twins(key);
const pairs = Object.entries(tw);
const alternates = !noindex && pairs.length > 1 ? pairs : [];
const xDefault = alternates.length && tw.en ? ORIGIN + tw.en : null;   // x-default → English, on purpose (spec §4)
const org = key === 'index' ? JSON.stringify({
  '@context': 'https://schema.org', '@type': 'Organization',
  name: 'WINSERV', legalName: 'M. SAMOILENKO INFORMATICA',
  url: ORIGIN + '/', logo: ORIGIN + '/images/winserv-logo.svg',
  email: 'comercial@winserv.com.br', sameAs: ['https://www.linkedin.com/company/winserv/'],
}) : null;
---
<!DOCTYPE html>
<html lang={lang.html}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="only light" />
  <link rel="icon" href="/images/winserv-logo.svg" type="image/svg+xml" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
  {!noindex && <link rel="canonical" href={url} />}
  {alternates.map(([l, p]) => <link rel="alternate" hreflang={LANG[l].hreflang} href={ORIGIN + p} />)}
  {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
  {!noindex && <meta property="og:type" content={ogType} />}
  {!noindex && <meta property="og:site_name" content="WINSERV" />}
  {!noindex && <meta property="og:locale" content={lang.og} />}
  {!noindex && pairs.filter(([l]) => l !== locale).map(([l]) => <meta property="og:locale:alternate" content={LANG[l].og} />)}
  {!noindex && <meta property="og:url" content={url} />}
  {!noindex && <meta property="og:title" content={ogTitle} />}
  {!noindex && ogDescription && <meta property="og:description" content={ogDescription} />}
  {!noindex && <meta property="og:image" content={image} />}
  {!noindex && <meta name="twitter:card" content="summary_large_image" />}
  {!noindex && <meta name="twitter:title" content={ogTitle} />}
  {!noindex && ogDescription && <meta name="twitter:description" content={ogDescription} />}
  {!noindex && <meta name="twitter:image" content={image} />}
  {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
  {org && <script type="application/ld+json" set:html={org} />}
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <Nav active={active} locale={locale} routeKey={key} noindex={noindex} />
  <slot />
  {key.startsWith('wifi') && <WifiLinks locale={locale} />}
  <Footer locale={locale} />
  <script is:inline src="/js/site.js" defer></script>
  {scripts.map((src) => <script is:inline src={src} defer></script>)}
</body>
</html>
